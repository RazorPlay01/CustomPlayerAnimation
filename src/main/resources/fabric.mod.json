{
  "schemaVersion": 1,
  "id": "custom_player_animations",
  "version": "${version}",
  "name": "Custom Player Animations",
  "description": "Mod creado para uso personal no permitida su comercializacion y/o distribucion sin mi permiso",
  "authors": [
    "RazorPlay01"
  ],
  "contributors": [
    "JarpPlay",
    "McVader34",
    "Kelvin285"
  ],
  "contact": {
    "homepage": "https://github.com/RazorPlay01",
    "sources": "https://github.com/RazorPlay01"
  },
  "license": "All Rights Reserved",
  "icon": "assets/custom_player_animations/CPA.icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.razorplay.customplayeranimations.CustomPlayerAnimations"
    ],
    "client": [
      "dev.razorplay.customplayeranimations.CustomPlayerAnimations"
    ],
    "modmenu": [
      "dev.razorplay.customplayeranimations.config.ModMenuConfig"
    ]
  },
  "mixins": [
    "custom_player_animations.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_742": [
        "dev/razorplay/customplayeranimations/util/interfaces/IAnimationControl"
      ]
    }
  }
}