{
  "schemaVersion": 1,
  "id": "cpa",
  "version": "${version}",
  "name": "Custom Player Animations",
  "description": "Improves and customizes the player's default animations.",
  "authors": [
    "RazorPlay01"
  ],
  "contributors": [
    "JarpPlay - Animations",
    "----------------------",
    "McVader34 - Inspiration and ideas",
    "Kelvin285 - Inspiration and ideas"
  ],
  "contact": {
    "homepage": "https://github.com/RazorPlay01"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/cpa/CPA.icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.razorplay01.cpa.CustomPlayerAnimations"
    ],
    "modmenu": [
      "com.github.razorplay01.cpa.config.ModMenuConfig"
    ]
  },
  "mixins": [
    "cpa.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "player_animation_library": ">=${pal_version}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_742": [
        "com/github/razorplay01/cpa/util/interfaces/IAnimationControl",
        "com/github/razorplay01/cpa/util/interfaces/ICustomAnimatedPlayer"
      ]
    }
  }
}
